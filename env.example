# Скопируйте в .env и заполните
PORT=3000
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Папка для базы SQLite (на хостинге укажите путь к постоянному диску)
DATA_DIR=./data
# true, если сайт работает по HTTPS (на хостинге почти всегда)
COOKIE_SECURE=false
# Разрешить студентам самим регистрироваться (true/false)
ALLOW_REGISTRATION=true
